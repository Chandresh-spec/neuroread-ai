# ==============================================================================
# NeuroReader Environment Variables
# Copy this file to .env on your AWS EC2 instance: cp .env.example .env
# ==============================================================================

# ── Django Core Settings ──────────────────────────────────────────────────────
SECRET_KEY=generate_a_secure_random_key_here
DEBUG=False

# Comma-separated list of hostnames/IPs allowed to serve the app
# Include your EC2 Public IP, Elastic IP, and/or custom domain
# Example: ALLOWED_HOSTS=54.123.45.67,neuroreader.example.com,localhost,127.0.0.1
ALLOWED_HOSTS=*

# Comma-separated list of trusted origins for CSRF
# Example: CSRF_TRUSTED_ORIGINS=http://54.123.45.67,https://neuroreader.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost

# ── AWS S3 Storage Configuration (For PDF and File Uploads) ───────────────────
# Set USE_S3=True to enable S3 storage for PDF/document uploads
USE_S3=True
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_STORAGE_BUCKET_NAME=your_s3_bucket_name_here
AWS_S3_REGION_NAME=us-east-1

# Optional custom domain or CloudFront distribution (leave blank to use standard S3 domain)
# AWS_S3_CUSTOM_DOMAIN=your-bucket.s3.amazonaws.com

# ── AI Inference Engine (Groq LPU) ───────────────────────────────────────────
# Ultra-fast Groq LPU API key for sub-second text simplification & definitions
GROQ_API_KEY=your_groq_api_key_here

# ── Google OAuth Configuration (Optional) ────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
